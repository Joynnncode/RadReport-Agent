.venv/
.git/
.github/
__pycache__/
*.pyc
.pytest_cache/

# Never let a key reach the build context: anything copied in is recoverable
# from the image layers.
.env
.env.*

# Large or regenerable
data/*
artifacts/
traces/
.cache/
evals/results/
docs/

# ...except the two data files git already ships. Locally compose mounts ./data
# over the top, which hid that the image never contained them; a cloud container
# has nothing to mount, and without these its retriever has no corpus.
!data/reports.csv
!data/demo_cache.json
